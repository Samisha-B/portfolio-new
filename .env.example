# Contact form (Resend). Set these in Vercel -> Settings -> Environment Variables.
RESEND_API_KEY=
# The inbox that receives enquiries. Without a verified domain this must be the email you signed up to Resend with.
CONTACT_TO_EMAIL=
# Optional. Default is onboarding@resend.dev. After verifying your own domain: Simran B. <hello@yourdomain.com>
RESEND_FROM=
NEXT_PUBLIC_SITE_URL=https://your-domain.com
